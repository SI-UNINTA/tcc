%  Use para: artigos do IEEE, ACM, SciELO, Periódicos CAPES
% ============================================================

@article{autor2022exemplo,
  author    = {Silva, João Carlos and Oliveira, Maria Fernanda},
  title     = {Título do artigo científico aqui},
  journal   = {Nome do Periódico ou Revista},
  year      = {2022},
  volume    = {15},
  number    = {3},
  pages     = {100--120},
  doi       = {10.1000/exemplo.doi.aqui},
  url       = {https://doi.org/10.1000/exemplo},
}
% Cite com: \cite{autor2022exemplo}  →  (SILVA; OLIVEIRA, 2022)
%           \textcite{autor2022exemplo}  →  Silva e Oliveira (2022)


